---
import { resolveAndRegisterClick } from '../lib/server/services/url-service';

const { code } = Astro.params;

if (!code) {
  return Astro.redirect('/404');
}

const targetUrl = await resolveAndRegisterClick(code);

if (!targetUrl) {
  return Astro.redirect('/404');
}

const originalUrl = targetUrl.originalUrl;

// Perform 307 temporary redirect
return Astro.redirect(originalUrl, 307);
---
<!-- Redirection layout (fallbacks in case client doesn't redirect instantly) -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0;url=${originalUrl}`} />
  <title>Redireccionando...</title>
</head>
<body class="bg-[#121310] text-[#575855] flex items-center justify-center min-h-screen font-sans">
  <div class="text-center">
    <div class="inline-block w-8 h-8 border-4 border-[#94C700] border-t-transparent rounded-full animate-spin mb-4"></div>
    <p class="text-lg">Redireccionando a <span class="text-white font-medium">{originalUrl}</span>...</p>
  </div>
</body>
</html>
